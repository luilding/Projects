   "source": [
    "import pandas as pd\n",
    "import os\n",
    "from collections import defaultdict, deque\n",
    "import time\n",
    "import folium\n",
    "from datetime import datetime\n",
    "import webbrowser\n",
    "\n",
    "class SimpleTramRouter:\n",
    "    def __init__(self):\n",
    "        start_time = time.time()\n",
    "        print(\"Starting router initialization...\")\n",
    "        \n",
    "        current_dir = os.path.join('..', 'mpt_data', 'tram')\n",
    "        \n",
    "        # Read GTFS files\n",
    "        print(\"\\nLoading GTFS files...\")\n",
    "        file_load_start = time.time()\n",
    "        self.stops = pd.read_csv(os.path.join(current_dir, 'stops.txt'))\n",
    "        self.routes = pd.read_csv(os.path.join(current_dir, 'routes.txt'))\n",
    "        self.trips = pd.read_csv(os.path.join(current_dir, 'trips.txt'))\n",
    "        self.stop_times = pd.read_csv(os.path.join(current_dir, 'stop_times.txt'))\n",
    "        print(f\"File loading took {time.time() - file_load_start:.2f} seconds\")\n",
    "        \n",
    "        # Build route network\n",
    "        print(\"\\nBuilding network...\")\n",
    "        network_start = time.time()\n",
    "        self._build_network()\n",
    "        print(f\"Network building took {time.time() - network_start:.2f} seconds\")\n",
    "        \n",
    "        print(f\"\\nTotal initialization took {time.time() - start_time:.2f} seconds\")\n",
    "        print(f\"Network size: {len(self.stop_routes)} stops and {len(self.route_stops)} routes\")\n",
    "    \n",
    "    def _build_network(self):\n",
    "        \"\"\"Build a network of which stops are connected by which routes\"\"\"\n",
    "        merge_start = time.time()\n",
    "        \n",
    "        # Merge stop_times with trips to get route information\n",
    "        stop_route_data = self.stop_times.merge(\n",
    "            self.trips[['trip_id', 'route_id']], \n",
    "            on='trip_id'\n",
    "        )[['stop_id', 'route_id']]\n",
    "        \n",
    "        print(f\"  Merging dataframes took {time.time() - merge_start:.2f} seconds\")\n",
    "        \n",
    "        # Build mappings using groupby\n",
    "        mapping_start = time.time()\n",
    "        self.stop_routes = {\n",
    "            stop_id: set(group['route_id']) \n",
    "            for stop_id, group in stop_route_data.groupby('stop_id')\n",
    "        }\n",
    "        self.route_stops = {\n",
    "            route_id: set(group['stop_id']) \n",
    "            for route_id, group in stop_route_data.groupby('route_id')\n",
    "        }\n",
    "        print(f\"  Building mappings took {time.time() - mapping_start:.2f} seconds\")\n",
    "    \n",
    "    def find_nearby_stops(self, location_name, limit=3):\n",
    "        \"\"\"Find stops that match the given name\"\"\"\n",
    "        matches = self.stops[self.stops['stop_name'].str.contains(location_name, case=False, na=False)]\n",
    "        return matches.head(limit)\n",
    "    \n",
    "    def find_route(self, start_location, end_location, visualize=True):\n",
    "        \"\"\"Find a route between two locations with minimum transfers\"\"\"\n",
    "        # Find matching stops\n",
    "        start_stops = self.find_nearby_stops(start_location)\n",
    "        end_stops = self.find_nearby_stops(end_location)\n",
    "        \n",
    "        if start_stops.empty or end_stops.empty:\n",
    "            return \"Could not find stops matching the provided locations\"\n",
    "        \n",
    "        end_stop_ids = set(end_stops['stop_id'])\n",
    "        \n",
    "        # Try finding a route from each start stop\n",
    "        best_route = None\n",
    "        best_transfers = float('inf')\n",
    "        \n",
    "        for _, start_stop in start_stops.iterrows():\n",
    "            route = self._bfs_route(start_stop['stop_id'], end_stop_ids)\n",
    "            if route and len(route) - 1 < best_transfers:\n",
    "                best_route = route\n",
    "                best_transfers = len(route) - 1\n",
    "        \n",
    "        if best_route is None:\n",
    "            return \"No route found between the specified locations\"\n",
    "        \n",
    "        route_description = self._format_route(best_route)\n",
    "        \n",
    "        if visualize:\n",
    "            map_file = self._visualize_route(best_route)\n",
    "            print(f\"\\nMap saved to: {map_file}\")\n",
    "            webbrowser.open('file://' + os.path.abspath(map_file))\n",
    "        \n",
    "        return route_description\n",
    "    \n",
    "    def _bfs_route(self, start_stop_id, end_stop_ids):\n",
    "        \"\"\"Use BFS to find route with minimum transfers\"\"\"\n",
    "        queue = deque([(start_stop_id, [start_stop_id], set())])\n",
    "        visited = {start_stop_id}\n",
    "        \n",
    "        while queue:\n",
    "            current_stop, path, current_routes = queue.popleft()\n",
    "            \n",
    "            if current_stop in end_stop_ids:\n",
    "                return path\n",
    "            \n",
    "            routes = self.stop_routes[current_stop]\n",
    "            \n",
    "            for route_id in routes:\n",
    "                for next_stop in self.route_stops[route_id]:\n",
    "                    if next_stop not in visited:\n",
    "                        visited.add(next_stop)\n",
    "                        new_routes = current_routes | {route_id}\n",
    "                        queue.append((next_stop, path + [next_stop], new_routes))\n",
    "        \n",
    "        return None\n",
    "\n",
    "    def _visualize_route(self, stop_ids):\n",
    "        \"\"\"Create an interactive map showing the route\"\"\"\n",
    "        # Get coordinates for the first stop to center the map\n",
    "        first_stop = self.stops[self.stops['stop_id'] == stop_ids[0]].iloc[0]\n",
    "        m = folium.Map(location=[first_stop['stop_lat'], first_stop['stop_lon']], zoom_start=13)\n",
    "        \n",
    "        prev_route = None\n",
    "        route_coordinates = []\n",
    "        \n",
    "        # Add markers and route lines\n",
    "        for i in range(len(stop_ids)):\n",
    "            current_stop = self.stops[self.stops['stop_id'] == stop_ids[i]].iloc[0]\n",
    "            \n",
    "            # Add marker for stop\n",
    "            if i == 0:  # Start stop\n",
    "                icon_color = 'green'\n",
    "                popup_prefix = 'Start: '\n",
    "            elif i == len(stop_ids) - 1:  # End stop\n",
    "                icon_color = 'red'\n",
    "                popup_prefix = 'End: '\n",
    "            else:  # Transfer stops\n",
    "                icon_color = 'blue'\n",
    "                popup_prefix = 'Transfer: '\n",
    "            \n",
    "            folium.Marker(\n",
    "                [current_stop['stop_lat'], current_stop['stop_lon']],\n",
    "                popup=popup_prefix + current_stop['stop_name'],\n",
    "                icon=folium.Icon(color=icon_color)\n",
    "            ).add_to(m)\n",
    "            \n",
    "            # Add route line\n",
    "            if i > 0:\n",
    "                prev_stop = self.stops[self.stops['stop_id'] == stop_ids[i-1]].iloc[0]\n",
    "                current_routes = self.stop_routes[stop_ids[i]] & self.stop_routes[stop_ids[i-1]]\n",
    "                if current_routes:\n",
    "                    route_id = list(current_routes)[0]\n",
    "                    route_name = self.routes[self.routes['route_id'] == route_id]['route_short_name'].iloc[0]\n",
    "                    \n",
    "                    if route_id != prev_route:\n",
    "                        if route_coordinates:\n",
    "                            # Draw previous route segment\n",
    "                            folium.PolyLine(\n",
    "                                locations=route_coordinates,\n",
    "                                weight=3,\n",
    "                                color='blue',\n",
    "                                popup=f'Tram {prev_route}'\n",
    "                            ).add_to(m)\n",
    "                            route_coordinates = []\n",
    "                        prev_route = route_id\n",
    "                    \n",
    "                    route_coordinates.extend([[prev_stop['stop_lat'], prev_stop['stop_lon']],\n",
    "                                           [current_stop['stop_lat'], current_stop['stop_lon']]])\n",
    "        \n",
    "        # Draw final route segment\n",
    "        if route_coordinates:\n",
    "            folium.PolyLine(\n",
    "                locations=route_coordinates,\n",
    "                weight=3,\n",
    "                color='blue',\n",
    "                popup=f'Tram {prev_route}'\n",
    "            ).add_to(m)\n",
    "        \n",
    "        # Save map to file\n",
    "        timestamp = datetime.now().strftime(\"%Y-%m-%d_%H-%M\")\n",
    "        output_dir = os.path.join('..', 'mpt_data', 'maps')\n",
    "        os.makedirs(output_dir, exist_ok=True)\n",
    "        map_file = os.path.join(output_dir, f'tram_route_{timestamp}.html')\n",
    "        m.save(map_file)\n",
    "        \n",
    "        return map_file\n",
    "    \n",
    "    def _format_route(self, stop_ids):\n",
    "        \"\"\"Format the route into human-readable instructions\"\"\"\n",
    "        route_description = []\n",
    "        current_route = None\n",
    "        \n",
    "        for i in range(len(stop_ids) - 1):\n",
    "            current_stop = stop_ids[i]\n",
    "            next_stop = stop_ids[i + 1]\n",
    "            \n",
    "            current_routes = self.stop_routes[current_stop] & self.stop_routes[next_stop]\n",
    "            if current_routes:\n",
    "                route_id = list(current_routes)[0]\n",
    "                route_name = self.routes[self.routes['route_id'] == route_id]['route_short_name'].iloc[0]\n",
    "                \n",
    "                if route_name != current_route:\n",
    "                    current_stop_name = self.stops[self.stops['stop_id'] == current_stop]['stop_name'].iloc[0]\n",
    "                    if current_route:\n",
    "                        route_description.append(f\"Transfer at {current_stop_name}\")\n",
    "                    route_description.append(f\"Take tram {route_name} from {current_stop_name}\")\n",
    "                    current_route = route_name\n",
    "        \n",
    "        final_stop = self.stops[self.stops['stop_id'] == stop_ids[-1]]['stop_name'].iloc[0]\n",
    "        route_description.append(f\"Arrive at {final_stop}\")\n",
    "        \n",
    "        return \"\\n\".join(route_description)\n",
    "\n",
    "# Example usage:\n",
    "if __name__ == \"__main__\":\n",
    "    router = SimpleTramRouter()\n",
    "    route = router.find_route(\"Southbank\", \"Collingwood\")\n",
    "    print(\"\\nRoute instructions:\")\n",
    "    print(route)"
   ]
  },
