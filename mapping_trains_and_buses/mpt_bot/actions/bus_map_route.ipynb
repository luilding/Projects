    "import requests\n",
    "import folium\n",
    "from geopy.geocoders import Nominatim\n",
    "from datetime import datetime\n",
    "import pandas as pd\n",
    "from scipy.spatial import KDTree\n",
    "from geopy.distance import geodesic\n",
    "import os\n",
    "import webbrowser\n",
    "\n",
    "def get_project_root():\n",
    "    \"\"\"Get the project root directory by going up one level from the current directory\"\"\"\n",
    "    current_dir = os.getcwd()\n",
    "    return os.path.dirname(current_dir)\n",
    "\n",
    "def ensure_directory_exists(directory):\n",
    "    \"\"\"Create directory if it doesn't exist\"\"\"\n",
    "    if not os.path.exists(directory):\n",
    "        os.makedirs(directory)\n",
    "\n",
    "def load_gtfs_data(project_root):\n",
    "    \"\"\"Load all required GTFS files\"\"\"\n",
    "    data_dir = os.path.join(project_root, 'mpt_data', 'bus')\n",
    "    \n",
    "    stops_df = pd.read_csv(os.path.join(data_dir, 'stops.txt'))\n",
    "    routes_df = pd.read_csv(os.path.join(data_dir, 'routes.txt'))\n",
    "    trips_df = pd.read_csv(os.path.join(data_dir, 'trips.txt'))\n",
    "    stop_times_df = pd.read_csv(os.path.join(data_dir, 'stop_times.txt'))\n",
    "    shapes_df = pd.read_csv(os.path.join(data_dir, 'shapes.txt')) if os.path.exists(os.path.join(data_dir, 'shapes.txt')) else None\n",
    "    \n",
    "    print(f\"Loaded {len(stops_df)} stops\")\n",
    "    print(f\"Loaded {len(routes_df)} routes\")\n",
    "    print(f\"Loaded {len(trips_df)} trips\")\n",
    "    print(f\"Loaded {len(stop_times_df)} stop times\")\n",
    "    \n",
    "    return stops_df, routes_df, trips_df, stop_times_df, shapes_df\n",
    "\n",
    "def find_direct_route(stop_times_df, trips_df, routes_df, start_stop_id, end_stop_id):\n",
    "    \"\"\"Find direct bus routes between two stops\"\"\"\n",
    "    print(f\"\\nSearching for routes between stop {start_stop_id} and {end_stop_id}\")\n",
    "    \n",
    "    #Get all trips that contain both stops\n",
    "    start_trips = set(stop_times_df[stop_times_df['stop_id'] == start_stop_id]['trip_id'])\n",
    "    end_trips = set(stop_times_df[stop_times_df['stop_id'] == end_stop_id]['trip_id'])\n",
    "    common_trips = start_trips & end_trips\n",
    "    \n",
    "    print(f\"Found {len(start_trips)} trips from start stop\")\n",
    "    print(f\"Found {len(end_trips)} trips from end stop\")\n",
    "    print(f\"Found {len(common_trips)} common trips\")\n",
    "    \n",
    "    if not common_trips:\n",
    "        return None\n",
    "    \n",
    "    valid_routes = []\n",
    "    for trip_id in common_trips:\n",
    "        trip_stops = stop_times_df[stop_times_df['trip_id'] == trip_id].sort_values('stop_sequence')\n",
    "        \n",
    "        #Check if start stop comes before end stop in sequence\n",
    "        start_seq = trip_stops[trip_stops['stop_id'] == start_stop_id]['stop_sequence'].iloc[0]\n",
    "        end_seq = trip_stops[trip_stops['stop_id'] == end_stop_id]['stop_sequence'].iloc[0]\n",
    "        \n",
    "        if start_seq < end_seq:\n",
    "            route_id = trips_df[trips_df['trip_id'] == trip_id]['route_id'].iloc[0]\n",
    "            route_info = routes_df[routes_df['route_id'] == route_id].iloc[0]\n",
    "            \n",
    "            #Get times\n",
    "            start_time = trip_stops[trip_stops['stop_id'] == start_stop_id]['departure_time'].iloc[0]\n",
    "            end_time = trip_stops[trip_stops['stop_id'] == end_stop_id]['arrival_time'].iloc[0]\n",
    "            \n",
    "            valid_routes.append({\n",
    "                'route_name': route_info['route_long_name'],\n",
    "                'route_number': route_info['route_short_name'],\n",
    "                'start_time': start_time,\n",
    "                'end_time': end_time,\n",
    "                'trip_id': trip_id,\n",
    "                'route_id': route_id\n",
    "            })\n",
    "    \n",
    "    print(f\"Found {len(valid_routes)} valid routes\")\n",
    "    return valid_routes if valid_routes else None\n",
    "\n",
    "def get_route_shape(shapes_df, route_id, trips_df):\n",
    "    \"\"\"Get the shape points for a specific route\"\"\"\n",
    "    if shapes_df is None:\n",
    "        return None\n",
    "    \n",
    "    #Get shape_id from trips for this route\n",
    "    trip = trips_df[trips_df['route_id'] == route_id]\n",
    "    if trip.empty:\n",
    "        return None\n",
    "    \n",
    "    shape_id = trip.iloc[0]['shape_id']\n",
    "    \n",
    "    #Get shape points\n",
    "    shape_points = shapes_df[shapes_df['shape_id'] == shape_id].sort_values('shape_pt_sequence')\n",
    "    if shape_points.empty:\n",
    "        return None\n",
    "        \n",
    "    return shape_points[['shape_pt_lat', 'shape_pt_lon']].values.tolist()\n",
    "\n",
    "def geocode_address(address):\n",
    "    geolocator = Nominatim(user_agent=\"bus_mapping_app1.0\")\n",
    "    melbourne_bbox = [(-38.5267, 144.5937), (-37.5113, 145.5125)]\n",
    "    \n",
    "    # Add some common location mappings\n",
    "    location_mappings = {\n",
    "        'mcg': 'Melbourne Cricket Ground, Melbourne',\n",
    "        'melbourne cricket ground': 'Melbourne Cricket Ground, Melbourne'\n",
    "    }\n",
    "    \n",
    "    # Check if we have a mapping for this address\n",
    "    search_address = location_mappings.get(address.lower(), address + ', Melbourne, Australia')\n",
    "    \n",
    "    location = geolocator.geocode(search_address, viewbox=melbourne_bbox, bounded=True)\n",
    "    \n",
    "    if location:\n",
    "        print(f\"Found location: {location.address}\")\n",
    "        print(f\"Coordinates: {location.latitude}, {location.longitude}\")\n",
    "        return location.latitude, location.longitude\n",
    "    else:\n",
    "        print(f\"Address '{address}' not found within Melbourne.\")\n",
    "        return None\n",
    "\n",
    "def find_nearest_stop(lat, lon, kdtree, df):\n",
    "    distance, index = kdtree.query([lat, lon])\n",
    "    nearest_stop = df.iloc[index]\n",
    "    \n",
    "    stop_coords = (nearest_stop[\"stop_lat\"], nearest_stop[\"stop_lon\"])\n",
    "    point_coords = (lat, lon)\n",
    "    distance_meters = geodesic(point_coords, stop_coords).meters\n",
    "    \n",
    "    print(f\"\\nNearest stop: {nearest_stop['stop_name']}\")\n",
    "    print(f\"Stop ID: {nearest_stop['stop_id']}\")\n",
    "    print(f\"Distance: {distance_meters:.0f} meters\")\n",
    "    \n",
    "    return nearest_stop, distance_meters, distance\n",
    "\n",
    "def visualize_route(start_location, start_stop, end_location, end_stop, route_info=None, route_shape=None):\n",
    "    m = folium.Map(location=[start_location[0], start_location[1]], zoom_start=13)\n",
    "    \n",
    "    # Add markers for start and end locations\n",
    "    folium.Marker(\n",
    "        [start_location[0], start_location[1]],\n",
    "        popup=\"Start\",\n",
    "        icon=folium.Icon(color='green')\n",
    "    ).add_to(m)\n",
    "    \n",
    "    folium.Marker(\n",
    "        [end_location[0], end_location[1]],\n",
    "        popup=\"Destination\",\n",
    "        icon=folium.Icon(color='red')\n",
    "    ).add_to(m)\n",
    "    \n",
    "    # Add markers for bus stops with route information\n",
    "    start_popup = f\"Bus Stop: {start_stop['stop_name']}\"\n",
    "    if route_info:\n",
    "        start_popup += f\"<br>Route: {route_info['route_number']}\"\n",
    "        start_popup += f\"<br>Departure: {route_info['start_time']}\"\n",
    "    \n",
    "    folium.Marker(\n",
    "        [start_stop[\"stop_lat\"], start_stop[\"stop_lon\"]],\n",
    "        popup=start_popup,\n",
    "        icon=folium.Icon(color='blue')\n",
    "    ).add_to(m)\n",
    "    \n",
    "    end_popup = f\"Bus Stop: {end_stop['stop_name']}\"\n",
    "    if route_info:\n",
    "        end_popup += f\"<br>Arrival: {route_info['end_time']}\"\n",
    "    \n",
    "    folium.Marker(\n",
    "        [end_stop[\"stop_lat\"], end_stop[\"stop_lon\"]],\n",
    "        popup=end_popup,\n",
    "        icon=folium.Icon(color='blue')\n",
    "    ).add_to(m)\n",
    "    \n",
    "    # Draw walking lines\n",
    "    folium.PolyLine(\n",
    "        locations=[[start_location[0], start_location[1]], \n",
    "                  [start_stop[\"stop_lat\"], start_stop[\"stop_lon\"]]],\n",
    "        weight=2,\n",
    "        color='green',\n",
    "        opacity=0.8,\n",
    "        popup='Walk to bus stop'\n",
    "    ).add_to(m)\n",
    "    \n",
    "    # Draw bus route\n",
    "    if route_shape:\n",
    "        folium.PolyLine(\n",
    "            locations=route_shape,\n",
    "            weight=3,\n",
    "            color='blue',\n",
    "            opacity=0.8,\n",
    "            popup=f\"Bus route {route_info['route_number'] if route_info else ''}\"\n",
    "        ).add_to(m)\n",
    "    else:\n",
    "        folium.PolyLine(\n",
    "            locations=[[start_stop[\"stop_lat\"], start_stop[\"stop_lon\"]], \n",
    "                      [end_stop[\"stop_lat\"], end_stop[\"stop_lon\"]]],\n",
    "            weight=3,\n",
    "            color='blue',\n",
    "            opacity=0.8,\n",
    "            popup=f\"Bus route {route_info['route_number'] if route_info else ''}\"\n",
    "        ).add_to(m)\n",
    "    \n",
    "    folium.PolyLine(\n",
    "        locations=[[end_stop[\"stop_lat\"], end_stop[\"stop_lon\"]], \n",
    "                  [end_location[0], end_location[1]]],\n",
    "        weight=2,\n",
    "        color='red',\n",
    "        opacity=0.8,\n",
    "        popup='Walk to destination'\n",
    "    ).add_to(m)\n",
    "    \n",
    "    output_dir = os.path.join(get_project_root(), 'mpt_data')\n",
    "    ensure_directory_exists(output_dir)\n",
    "    \n",
    "    timestamp = datetime.now().strftime(\"%Y-%m-%d_%H-%M\")\n",
    "    map_file = os.path.join(output_dir, f'bus_directions_{timestamp}.html')\n",
    "    \n",
    "    m.save(map_file)\n",
    "    return map_file\n",
    "\n",
    "def main():\n",
    "    print(\"\\nBus Route Planner\")\n",
    "    print(\"-----------------\")\n",
    "    \n",
    "    try:\n",
    "        # Get the project root directory and load all GTFS data\n",
    "        project_root = get_project_root()\n",
    "        stops_df, routes_df, trips_df, stop_times_df, shapes_df = load_gtfs_data(project_root)\n",
    "        \n",
    "        # Create the k-d tree\n",
    "        coords = stops_df[[\"stop_lat\", \"stop_lon\"]].values\n",
    "        kdtree = KDTree(coords)\n",
    "        \n",
    "        # Get user input\n",
    "        current_location = input(\"\\nEnter your starting location: \")\n",
    "        destination_input = input(\"Enter your destination: \")\n",
    "        \n",
    "        print(\"\\nProcessing your request...\")\n",
    "        \n",
    "        # Geocode locations and find nearest stops\n",
    "        start_coords = geocode_address(current_location)\n",
    "        if not start_coords:\n",
    "            raise ValueError(\"Could not find starting location.\")\n",
    "            \n",
    "        nearest_start_stop, start_distance, _ = find_nearest_stop(start_coords[0], start_coords[1], kdtree, stops_df)\n",
    "        \n",
    "        end_coords = geocode_address(destination_input)\n",
    "        if not end_coords:\n",
    "            raise ValueError(\"Could not find destination location.\")\n",
    "        \n",
    "        nearest_end_stop, end_distance, _ = find_nearest_stop(end_coords[0], end_coords[1], kdtree, stops_df)\n",
    "        \n",
    "        # Find available routes\n",
    "        routes = find_direct_route(stop_times_df, trips_df, routes_df, \n",
    "                                 nearest_start_stop['stop_id'], \n",
    "                                 nearest_end_stop['stop_id'])\n",
    "        \n",
    "        if routes:\n",
    "            # Use the first available route for now\n",
    "            best_route = routes[0]\n",
    "            \n",
    "            # Get route shape\n",
    "            route_shape = get_route_shape(shapes_df, best_route['route_id'], trips_df)\n",
    "            \n",
    "            # Generate the map with route information\n",
    "            map_file = visualize_route(\n",
    "                start_coords, \n",
    "                nearest_start_stop, \n",
    "                end_coords, \n",
    "                nearest_end_stop,\n",
    "                best_route,\n",
    "                route_shape\n",
    "            )\n",
    "            \n",
    "            # Print route information\n",
    "            print(\"\\nRoute Details:\")\n",
    "            print(f\"1. Walk {start_distance:.0f} meters to {nearest_start_stop['stop_name']} bus stop\")\n",
    "            print(f\"2. Take bus {best_route['route_number']} ({best_route['route_name']})\")\n",
    "            print(f\"   Departure: {best_route['start_time']}\")\n",
    "            print(f\"   Arrival: {best_route['end_time']}\")\n",
    "            print(f\"3. Walk {end_distance:.0f} meters to your destination\")\n",
    "            \n",
    "            # Show alternative routes if available\n",
    "            if len(routes) > 1:\n",
    "                print(\"\\nAlternative routes available:\")\n",
    "                for route in routes[1:]:\n",
    "                    print(f\"- Bus {route['route_number']} ({route['route_name']})\")\n",
    "                    print(f\"  Departure: {route['start_time']}, Arrival: {route['end_time']}\")\n",
    "        else:\n",
    "            print(\"\\nNo direct bus routes found between these stops.\")\n",
    "            \n",
    "            # Let's provide more information about why no routes were found\n",
    "            print(\"\\nDebugging information:\")\n",
    "            print(f\"Start stop ID: {nearest_start_stop['stop_id']}\")\n",
    "            print(f\"End stop ID: {nearest_end_stop['stop_id']}\")\n",
    "            print(\"Try different stops or consider multiple bus transfers.\")\n",
    "            \n",
    "            # Generate basic map without route information\n",
    "            map_file = visualize_route(\n",
    "                start_coords, \n",
    "                nearest_start_stop, \n",
    "                end_coords, \n",
    "                nearest_end_stop\n",
    "            )\n",
    "        \n",
    "        print(f\"\\nMap saved as: {map_file}\")\n",
    "        webbrowser.open('file://' + os.path.abspath(map_file))\n",
    "        \n",
    "    except FileNotFoundError as e:\n",
    "        print(f\"Error: {str(e)}\")\n",
    "    except Exception as e:\n",
    "        print(f\"An error occurred: {str(e)}\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
